# Output of the one-off PDF extraction scripts in tools/. These are page images and
# page text taken from the reference standards above, so they carry the same
# copyright as the originals. The scripts are versioned; their output is not.
tools/extracted/
tools/rendered/

# Timestamped pre-edit copies of live modules. Git history serves this purpose, and
# tracked copies shadow the real modules in grep and code search.
_backups/
